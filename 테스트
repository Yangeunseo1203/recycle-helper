<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>사진 한 장으로 끝내는 분리배출 도우미</title>
  <!-- TensorFlow.js 및 Teachable Machine Image 라이브러리 (버전 고정) -->
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.20.0/dist/tf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@teachablemachine/image@0.8.5/dist/teachablemachine-image.min.js"></script>
  <style>
    :root {
      --primary: #0d9488;
      --primary-dark: #0f766e;
      --primary-light: #ccfbf1;
      --green-accent: #16a34a;
      --green-light: #dcfce7;
      --bg-page: #f0fdf4;
      --bg-card: #ffffff;
      --text-main: #0f172a;
      --text-sub: #475569;
      --border-color: #cbd5e1;
      --warn-bg: #fef3c7;
      --warn-text: #92400e;
      --error-bg: #fee2e2;
      --error-text: #991b1b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Malgun Gothic", sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      line-height: 1.5;
      font-size: 16px;
    }

    .app-container {
      max-width: 480px;
      min-height: 100vh;
      margin: 0 auto;
      padding: 20px 16px 36px;
      display: flex;
      flex-direction: column;
    }

    .hidden { display: none !important; }

    .alert-box {
      background-color: var(--error-bg);
      color: var(--error-text);
      border: 1px solid #fca5a5;
      border-radius: 12px;
      padding: 14px 16px;
      margin-bottom: 16px;
      font-size: 0.95rem;
      font-weight: 600;
      word-break: keep-all;
    }

    .alert-box.warning {
      background-color: var(--warn-bg);
      color: var(--warn-text);
      border-color: #fcd34d;
    }

    .screen { display: flex; flex-direction: column; gap: 16px; flex: 1; }
    .hero-header { padding-top: 8px; }

    .badge {
      display: inline-block;
      background-color: var(--primary-light);
      color: var(--primary-dark);
      font-weight: 700;
      font-size: 0.85rem;
      padding: 6px 12px;
      border-radius: 999px;
      margin-bottom: 10px;
    }

    .hero-header h1 {
      font-size: 1.7rem;
      font-weight: 800;
      line-height: 1.3;
      color: #064e3b;
      margin-bottom: 8px;
      word-break: keep-all;
    }

    .subtitle { font-size: 1rem; color: var(--text-sub); word-break: keep-all; }

    .privacy-card {
      display: flex;
      align-items: center;
      gap: 12px;
      background-color: var(--bg-card);
      border: 1.5px solid #99f6e4;
      border-radius: 14px;
      padding: 14px 16px;
      box-shadow: 0 2px 6px rgba(13, 148, 136, 0.06);
    }

    .privacy-icon { font-size: 1.4rem; flex-shrink: 0; }
    .privacy-card p { font-size: 0.92rem; font-weight: 600; color: #115e59; word-break: keep-all; }

    .status-pill {
      text-align: center;
      font-size: 0.9rem;
      color: var(--primary-dark);
      background-color: #e6fffa;
      padding: 10px;
      border-radius: 10px;
      font-weight: 600;
    }

    /* 실시간 웹캠 영역 */
    .webcam-box {
      background: #0f172a;
      border-radius: 16px;
      overflow: hidden;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .webcam-box video {
      width: 100%;
      max-height: 320px;
      border-radius: 10px;
      object-fit: cover;
      background: #000;
    }

    .webcam-controls {
      display: flex;
      gap: 8px;
    }

    .action-buttons { display: flex; flex-direction: column; gap: 12px; margin-top: auto; }

    .btn {
      width: 100%;
      min-height: 52px;
      padding: 13px 18px;
      font-size: 1.05rem;
      font-weight: 700;
      border-radius: 14px;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 0.15s ease, transform 0.1s ease;
    }

    .btn:active:not(:disabled) { transform: scale(0.98); }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-primary { background-color: var(--primary); color: #ffffff; }
    .btn-primary:hover:not(:disabled) { background-color: var(--primary-dark); }
    .btn-secondary { background-color: var(--green-accent); color: #ffffff; }
    .btn-secondary:hover:not(:disabled) { background-color: #15803d; }
    .btn-outline { background-color: #ffffff; color: var(--primary-dark); border: 2px solid var(--primary); }
    .btn-sub-action { background-color: #f1f5f9; color: var(--text-main); border: 1.5px solid var(--border-color); font-size: 0.98rem; }

    /* 모델 미연결 시 테스트용 패널 */
    .demo-panel {
      background-color: #ffffff;
      border: 1px dashed #94a3b8;
      border-radius: 14px;
      padding: 14px;
    }
    .demo-panel-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-sub);
      margin-bottom: 10px;
    }
    .demo-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .demo-btn {
      min-height: 44px;
      padding: 8px 10px;
      font-size: 0.88rem;
      font-weight: 700;
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      color: #1e293b;
      cursor: pointer;
    }
    .demo-btn:hover { background: #e2e8f0; }

    .card {
      background-color: var(--bg-card);
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
      border: 1px solid #e2e8f0;
    }

    .preview-card {
      position: relative;
      background-color: #0f172a;
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 200px;
      max-height: 280px;
    }

    .preview-card img { width: 100%; max-height: 280px; object-fit: contain; display: block; }

    .analyzing-overlay {
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.78);
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      font-weight: 700;
      font-size: 1.05rem;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 4px solid rgba(255, 255, 255, 0.3);
      border-top-color: #2dd4bf;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .result-header { border-bottom: 1px solid #e2e8f0; padding-bottom: 14px; margin-bottom: 14px; }

    .caption {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--primary-dark);
      background-color: var(--primary-light);
      padding: 3px 10px;
      border-radius: 6px;
      margin-bottom: 6px;
    }

    .result-title { font-size: 1.6rem; font-weight: 800; color: var(--text-main); word-break: keep-all; }
    .result-title.low-confidence { font-size: 1.15rem; font-weight: 600; color: var(--text-sub); }
    .result-score { font-size: 1.05rem; font-weight: 700; color: var(--primary); margin-top: 4px; }

    .top3-container h3 { font-size: 0.95rem; color: var(--text-sub); margin-bottom: 10px; }
    .bars-list { display: flex; flex-direction: column; gap: 10px; }
    .bar-item-header { display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 4px; }
    .bar-track { width: 100%; height: 10px; background-color: #e2e8f0; border-radius: 999px; overflow: hidden; }
    .bar-fill { height: 100%; background-color: var(--primary); border-radius: 999px; transition: width 0.3s ease; }

    .guide-card { background-color: #f0fdfa; border: 1.5px solid #5eead4; }
    .guide-card.warn-state { background-color: #fffbeb; border-color: #fcd34d; }
    .guide-message { font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 14px; word-break: keep-all; }
    .guide-actions { display: flex; flex-direction: column; gap: 10px; }

    .checklist-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .checklist-header h3 { font-size: 1.08rem; font-weight: 800; }
    .progress-text { font-size: 0.9rem; font-weight: 700; color: var(--primary-dark); }
    .checklist { list-style: none; display: flex; flex-direction: column; gap: 10px; }

    .checklist-item label {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      min-height: 50px;
      padding: 12px 14px;
      background-color: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      cursor: pointer;
      font-size: 0.98rem;
      font-weight: 600;
      word-break: keep-all;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .checklist-item input[type="checkbox"] {
      width: 22px;
      height: 22px;
      margin-top: 2px;
      accent-color: var(--green-accent);
      flex-shrink: 0;
    }
    .checklist-item.checked label { background-color: var(--green-light); border-color: #86efac; color: #14532d; text-decoration: line-through; }

    .complete-banner {
      margin-top: 14px;
      padding: 14px;
      background-color: var(--green-accent);
      color: #ffffff;
      border-radius: 12px;
      text-align: center;
      font-size: 1.15rem;
      font-weight: 800;
    }

    .source-note {
      margin-top: 12px;
      font-size: 0.8rem;
      color: var(--text-sub);
      text-align: right;
    }

    .result-footer { display: flex; flex-direction: column; gap: 14px; margin-top: 4px; }
    .disclaimer {
      text-align: center;
      font-size: 0.88rem;
      color: var(--text-sub);
      background-color: #f1f5f9;
      padding: 12px;
      border-radius: 10px;
      word-break: keep-all;
    }
  </style>
</head>
<body>
  <div class="app-container">
    <!-- 상단 공통 알림 배너 -->
    <div id="global-alert" class="alert-box hidden" role="alert"></div>

    <!-- [화면 1] 첫 화면 -->
    <main id="home-screen" class="screen">
      <header class="hero-header">
        <div class="badge">1인 가구 · 배달 용기 맞춤</div>
        <h1>사진 한 장으로 끝내는<br />분리배출 도우미</h1>
        <p class="subtitle">쓰레기 사진을 찍거나 올리면 종류와 오염 여부를 확인해 올바른 배출 방법을 알려드려요.</p>
      </header>

      <section class="privacy-card" aria-label="개인정보 보호 안내">
        <span class="privacy-icon" aria-hidden="true">🔒</span>
        <p>사진은 이 기기 안에서만 분석되고 서버로 전송되거나 저장되지 않아요.</p>
      </section>

      <div id="model-loading-status" class="status-pill">AI 모델을 불러오는 중이에요...</div>

      <!-- 실시간 카메라 미리보기 박스 -->
      <section id="webcam-container" class="webcam-box hidden">
        <video id="webcam-video" autoplay playsinline muted></video>
        <div class="webcam-controls">
          <button type="button" id="btn-capture-snap" class="btn btn-primary">📸 지금 촬영하기</button>
          <button type="button" id="btn-close-webcam" class="btn btn-sub-action" style="width: 38%;">닫기</button>
        </div>
      </section>

      <!-- 숨겨진 파일 입력 요소 -->
      <input type="file" id="camera-fallback-input" accept="image/*" capture="environment" class="hidden" />
      <input type="file" id="gallery-input" accept="image/*" class="hidden" />

      <section class="action-buttons">
        <button type="button" id="btn-camera" class="btn btn-primary">
          <span aria-hidden="true">📷</span> 카메라로 찍기
        </button>
        <button type="button" id="btn-gallery" class="btn btn-secondary">
          <span aria-hidden="true">🖼️</span> 사진 올리기
        </button>
      </section>

      <!-- 모델이 아직 없을 때도 바로 기능을 시연할 수 있는 테스트 패널 -->
      <section id="demo-test-panel" class="demo-panel hidden">
        <p class="demo-panel-title">🧪 AI 모델(model 폴더) 연결 전 기능 체험하기</p>
        <div class="demo-grid">
          <button type="button" class="demo-btn" data-class="깨끗한 플라스틱 용기" data-conf="0.92">깨끗한 플라스틱 (92%)</button>
          <button type="button" class="demo-btn" data-class="오염된 플라스틱 용기" data-conf="0.89">오염된 플라스틱 (89%)</button>
          <button type="button" class="demo-btn" data-class="캔" data-conf="0.95">캔 (95%)</button>
          <button type="button" class="demo-btn" data-class="유리병" data-conf="0.88">유리병 (88%)</button>
          <button type="button" class="demo-btn" data-class="종이" data-conf="0.91">종이 (91%)</button>
          <button type="button" class="demo-btn" data-class="비닐" data-conf="0.86">비닐 (86%)</button>
          <button type="button" class="demo-btn" data-class="캔" data-conf="0.42" style="grid-column: span 2; background:#fffbeb;">저신뢰도 판정 보류 테스트 (42%)</button>
        </div>
      </section>
    </main>

    <!-- [화면 2] 결과 화면 -->
    <main id="result-screen" class="screen hidden" aria-live="polite">
      <section class="preview-card">
        <img id="preview-image" src="" alt="선택한 쓰레기 사진 미리보기" />
        <div id="analyzing-overlay" class="analyzing-overlay hidden">
          <div class="spinner" aria-hidden="true"></div>
          <p>사진을 분석하고 있어요...</p>
        </div>
      </section>

      <section class="card">
        <div class="result-header">
          <span id="result-label-caption" class="caption">가장 높은 예측 결과</span>
          <h2 id="result-class-name" class="result-title">-</h2>
          <p id="result-confidence" class="result-score">신뢰도 0%</p>
        </div>
        <div class="top3-container">
          <h3>상위 3개 예측 확률</h3>
          <div id="top3-bars" class="bars-list"></div>
        </div>
      </section>

      <section id="context-guide-section" class="card guide-card hidden">
        <p id="context-guide-message" class="guide-message"></p>
        <div id="context-guide-actions" class="guide-actions"></div>
      </section>

      <section class="card">
        <div class="checklist-header">
          <h3>단계별 배출 체크리스트</h3>
          <span id="checklist-progress" class="progress-text">0 / 0 완료</span>
        </div>
        <ul id="checklist-items" class="checklist"></ul>
        <div id="checklist-complete-banner" class="complete-banner hidden" role="status">
          🎉 배출 준비 완료!
        </div>
        <p class="source-note">기준 참고: 환경부·한국환경공단 「분리의 정석」 품목별 배출요령</p>
      </section>

      <footer class="result-footer">
        <p class="disclaimer">AI 예측이며 틀릴 수 있어요. 헷갈리면 거주지 지자체 안내를 확인하세요.</p>
        <button type="button" id="btn-home" class="btn btn-outline">처음으로</button>
      </footer>
    </main>
  </div>

  <script>
    /**
     * 1. 전역 설정 (config)
     */
    const APP_CONFIG = Object.freeze({
      CLASSES: [
        "깨끗한 플라스틱 용기",
        "오염된 플라스틱 용기",
        "캔",
        "유리병",
        "종이",
        "비닐"
      ],
      CONFIDENCE_THRESHOLD: 0.7,
      MODEL_PATH: "./model/model.json",
      METADATA_PATH: "./model/metadata.json",
      MAX_FILE_SIZE_BYTES: 10 * 1024 * 1024
    });

    /**
     * 2. 배출 가이드 데이터
     * - 참고 출처: 환경부·한국환경공단 생활폐기물 분리배출 누리집 '분리의 정석' 품목별 배출방법
     */
    const [CLS_CLEAN_PLASTIC, CLS_DIRTY_PLASTIC, CLS_CAN, CLS_GLASS, CLS_PAPER, CLS_VINYL] = APP_CONFIG.CLASSES;

    const WASTE_CONTENT = {
      [CLS_CLEAN_PLASTIC]: {
        steps: [
          "비우기: 용기 안에 남은 내용물을 깨끗이 비워 주세요.",
          "헹구기: 이물질이 남지 않도록 물로 가볍게 헹궈 주세요.",
          "라벨·상표 떼기: 겉면에 붙은 비닐 라벨과 스티커를 제거해 주세요.",
          "다른 재질 분리하기: 뚜껑, 빨대 등 다른 재질 부속품을 분리해 주세요.",
          "플라스틱류 배출: 물기를 털어낸 뒤 플라스틱류(투명 생수·음료 페트병은 전용 수거함)로 배출하세요."
        ]
      },
      [CLS_DIRTY_PLASTIC]: {
        steps: [
          "음식물 비우기: 남은 음식물 찌꺼기는 음식물 쓰레기(또는 일반쓰레기)로 먼저 비워 주세요.",
          "헹구기: 물이나 세제로 용기에 묻은 기름기와 양념을 씻어내 주세요.",
          "재촬영: 깨끗해졌다면 아래 [다시 찍기] 버튼으로 다시 촬영해 확인하세요.",
          "지워지지 않으면 종량제봉투 배출: 세척해도 붉은 양념이나 기름이 남으면 재활용이 안 되므로 종량제봉투에 버려 주세요."
        ],
        unwashableSteps: [
          "물기 제거하기: 세척 과정에서 묻은 물기를 털어내 주세요.",
          "종량제봉투 배출: 이물질이 제거되지 않은 복합·오염 용기는 일반 종량제봉투에 담아 배출하세요."
        ]
      },
      [CLS_CAN]: {
        steps: [
          "비우기: 캔 내부의 음료나 내용물을 모두 비워 주세요.",
          "헹구기: 겉과 속의 이물질을 물로 깨끗이 헹궈 주세요.",
          "압착하기: 부피를 줄이기 위해 캔을 가볍게 눌러 납작하게 만들어 주세요. (부탄가스 등 스프레이는 야외에서 구멍을 뚫어 가스 제거)",
          "캔류 배출: 플라스틱 뚜껑 등 다른 재질을 분리한 뒤 캔·고철류 수거함에 배출하세요."
        ]
      },
      [CLS_GLASS]: {
        steps: [
          "비우기: 병 안의 내용물을 깨끗이 비워 주세요.",
          "헹구기: 물로 안쪽을 헹궈 이물질을 제거해 주세요.",
          "뚜껑·라벨 분리: 금속이나 플라스틱 뚜껑을 분리하고 제거 가능한 상표를 떼어 주세요.",
          "유리병류 배출: 깨지지 않도록 주의하여 유리병류 수거함에 배출하세요. (깨진 유리·도자기·내열유리는 종량제봉투/불연성 마대 배출)"
        ]
      },
      [CLS_PAPER]: {
        steps: [
          "이물질 제거: 테이프, 택배 송장(스티커), 스프링, 비닐 코팅 표지 등 종이가 아닌 부분을 모두 떼어 내세요.",
          "펼쳐서 접기: 상자나 종이류는 부피를 줄이기 위해 납작하게 펼쳐서 접어 주세요.",
          "종이류 배출: 물기에 젖지 않게 묶거나 정리해 종이류 수거함에 배출하세요. (영수증, 기름 묻은 종이, 물티슈는 종량제봉투 배출)"
        ]
      },
      [CLS_VINYL]: {
        steps: [
          "내용물 비우기 및 오염 확인: 비닐 안의 내용물을 비우고 음식물·기름기가 묻어 있는지 확인하세요.",
          "깨끗하면 비닐류 / 오염되었으면 종량제봉투: 이물질이 없는 깨끗한 비닐(과자·라면봉지, 에어캡 등)은 흩날리지 않게 모아 비닐류로, 이물질이 묻어 닦이지 않는 비닐은 종량제봉투로 배출하세요."
        ]
      }
    };

    /**
     * 3. 전역 상태 및 초기화
     */
    const appState = {
      model: null,
      isModelLoaded: false,
      isAnalyzing: false,
      isRetakeFlow: false,
      unwashableSelected: false,
      webcamStream: null,
      currentPredictions: [],
      checkedSteps: [],
      mockParams: null
    };

    const dom = {};

    document.addEventListener("DOMContentLoaded", () => {
      [
        "global-alert", "home-screen", "result-screen", "model-loading-status",
        "webcam-container", "webcam-video", "btn-capture-snap", "btn-close-webcam",
        "camera-fallback-input", "gallery-input", "btn-camera", "btn-gallery", "btn-home",
        "demo-test-panel", "preview-image", "analyzing-overlay", "result-label-caption",
        "result-class-name", "result-confidence", "top3-bars", "context-guide-section",
        "context-guide-message", "context-guide-actions", "checklist-progress",
        "checklist-items", "checklist-complete-banner"
      ].forEach((id) => {
        const camelKey = id.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
        dom[camelKey] = document.getElementById(id);
      });

      parseMockQueryParams();

      dom.btnCamera.addEventListener("click", () => startCamera(false));
      dom.btnCaptureSnap.addEventListener("click", captureFromWebcam);
      dom.btnCloseWebcam.addEventListener("click", stopWebcam);

      dom.btnGallery.addEventListener("click", () => {
        stopWebcam();
        dom.galleryInput.value = "";
        dom.galleryInput.click();
      });

      dom.cameraFallbackInput.addEventListener("change", (e) => handleImageInput(e, appState.isRetakeFlow));
      dom.galleryInput.addEventListener("change", (e) => handleImageInput(e, false));
      dom.btnHome.addEventListener("click", resetToHome);

      // 모델 미연결 시 체험용 버튼 이벤트 연결
      document.querySelectorAll(".demo-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const cls = btn.getAttribute("data-class");
          const conf = parseFloat(btn.getAttribute("data-conf"));
          runDemoWithSampleImage(cls, conf, false);
        });
      });

      loadTeachableMachineModel();
    });

    function showAlert(message, isWarning = false) {
      dom.globalAlert.textContent = message;
      dom.globalAlert.classList.remove("hidden", "warning");
      if (isWarning) dom.globalAlert.classList.add("warning");
    }

    function clearAlert() {
      dom.globalAlert.textContent = "";
      dom.globalAlert.classList.add("hidden", "warning");
    }

    function setButtonsDisabled(disabled) {
      dom.btnCamera.disabled = disabled;
      dom.btnGallery.disabled = disabled;
      dom.btnHome.disabled = disabled;
      dom.contextGuideActions.querySelectorAll("button").forEach((b) => (b.disabled = disabled));
    }

    function resetToHome() {
      if (appState.isAnalyzing) return;
      stopWebcam();
      clearAlert();
      Object.assign(appState, {
        isRetakeFlow: false,
        unwashableSelected: false,
        currentPredictions: [],
        checkedSteps: []
      });
      dom.cameraFallbackInput.value = "";
      dom.galleryInput.value = "";
      dom.previewImage.src = "";
      dom.resultScreen.classList.add("hidden");
      dom.homeScreen.classList.remove("hidden");
    }

    function parseMockQueryParams() {
      try {
        const params = new URLSearchParams(window.location.search);
        const mockClass = params.get("mock");
        if (!mockClass) return;
        const rawConf = parseFloat(params.get("conf"));
        appState.mockParams = {
          className: mockClass.trim(),
          confidence: Number.isFinite(rawConf) ? Math.min(Math.max(rawConf, 0), 1) : 0.9
        };
      } catch (e) {
        console.error(e);
      }
    }

    /**
     * 4. 모델 로딩 및 라벨 검증
     */
    async function loadTeachableMachineModel() {
      if (appState.mockParams) {
        dom.modelLoadingStatus.textContent = "분석 준비가 완료되었어요.";
        return;
      }
      try {
        if (typeof tmImage === "undefined") throw new Error("LIB_MISSING");
        const loadedModel = await tmImage.load(APP_CONFIG.MODEL_PATH, APP_CONFIG.METADATA_PATH);
        appState.model = loadedModel;
        appState.isModelLoaded = true;
        dom.modelLoadingStatus.textContent = "AI 모델 준비 완료! 사진을 선택해 주세요.";

        const labels = loadedModel.getClassLabels ? loadedModel.getClassLabels() : [];
        const diff = APP_CONFIG.CLASSES.filter((c) => !labels.includes(c))
          .concat(labels.filter((l) => !APP_CONFIG.CLASSES.includes(l)));
        if (diff.length > 0) {
          console.warn("라벨 불일치:", { expected: APP_CONFIG.CLASSES, actual: labels });
          showAlert("주의: 학습된 모델의 라벨 이름과 설정된 분류 클래스 이름이 다릅니다. 콘솔을 확인해 주세요.", true);
        }
      } catch (error) {
        console.error("모델 로딩 실패:", error);
        dom.modelLoadingStatus.textContent = "모델 파일이 없어 체험 모드가 활성화되었어요.";
        dom.demoTestPanel.classList.remove("hidden");
        showAlert("모델을 불러오지 못했어요. model 폴더를 확인해 주세요. (아래 체험 버튼으로 기능을 먼저 테스트할 수 있어요)", true);
      }
    }

    /**
     * 5. 카메라 기능 (실시간 후면 웹캠 우선 실행 -> 미지원/거부 시 파일 촬영창 자동 전환)
     */
    async function startCamera(isRetake = false) {
      clearAlert();
      appState.isRetakeFlow = isRetake;

      // 결과 화면에서 [다시 찍기]를 누른 경우 첫 화면으로 돌아와 웹캠 열기
      if (!dom.resultScreen.classList.contains("hidden")) {
        dom.resultScreen.classList.add("hidden");
        dom.homeScreen.classList.remove("hidden");
      }

      if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
        try {
          stopWebcam();
          const stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: { ideal: "environment" } },
            audio: false
          });
          appState.webcamStream = stream;
          dom.webcamVideo.srcObject = stream;
          dom.webcamContainer.classList.remove("hidden");
          return;
        } catch (err) {
          console.warn("실시간 카메라 접근 실패, 기본 카메라 입력으로 전환:", err);
        }
      }

      // 실시간 웹캠이 차단되었거나 미지원 브라우저일 경우 기본 카메라/파일 선택기 실행
      dom.cameraFallbackInput.value = "";
      dom.cameraFallbackInput.click();
    }

    function stopWebcam() {
      if (appState.webcamStream) {
        appState.webcamStream.getTracks().forEach((track) => track.stop());
        appState.webcamStream = null;
      }
      dom.webcamVideo.srcObject = null;
      dom.webcamContainer.classList.add("hidden");
    }

    function captureFromWebcam() {
      try {
        const video = dom.webcamVideo;
        if (!video.videoWidth || !video.videoHeight) {
          showAlert("카메라 화면을 준비 중이에요. 잠시 후 다시 눌러 주세요.");
          return;
        }

        const canvas = document.createElement("canvas");
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        const ctx = canvas.getContext("2d");
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

        const dataUrl = canvas.toDataURL("image/jpeg", 0.9);
        stopWebcam();

        appState.unwashableSelected = false;
        dom.previewImage.onload = () => {
          dom.homeScreen.classList.add("hidden");
          dom.resultScreen.classList.remove("hidden");
          classifyCurrentImage();
        };
        dom.previewImage.src = dataUrl;
      } catch (error) {
        console.error("촬영 오류:", error);
        showAlert("사진 촬영 중 오류가 발생했어요. [사진 올리기]를 이용해 주세요.");
      }
    }

    /**
     * 6. 이미지 파일 업로드 처리
     */
    function handleImageInput(event, isRetake = false) {
      try {
        const file = event.target.files && event.target.files[0];
        if (!file) return;

        if (!file.type || !file.type.startsWith("image/")) {
          showAlert("이미지 파일(JPG, PNG 등)만 올릴 수 있어요. 다른 파일을 선택해 주세요.");
          event.target.value = "";
          return;
        }
        if (file.size > APP_CONFIG.MAX_FILE_SIZE_BYTES) {
          showAlert("사진 용량이 10MB를 넘어요. 10MB 이하의 사진으로 다시 올려 주세요.");
          event.target.value = "";
          return;
        }

        clearAlert();
        appState.isRetakeFlow = isRetake;
        appState.unwashableSelected = false;

        const reader = new FileReader();
        reader.onload = (e) => {
          dom.previewImage.onload = () => {
            dom.homeScreen.classList.add("hidden");
            dom.resultScreen.classList.remove("hidden");
            classifyCurrentImage();
          };
          dom.previewImage.onerror = () => showAlert("손상된 이미지 파일이라 불러올 수 없어요.");
          dom.previewImage.src = e.target.result;
        };
        reader.onerror = () => showAlert("사진 파일을 읽는 중 오류가 발생했어요.");
        reader.readAsDataURL(file);
      } catch (error) {
        console.error(error);
        showAlert("사진을 처리하는 중 문제가 발생했어요. 다시 시도해 주세요.");
      }
    }

    /**
     * 7. 분류 실행 (실제 모델 / 모의 모드 / 체험 버튼)
     */
    async function classifyCurrentImage() {
      if (appState.isAnalyzing) return;
      appState.isAnalyzing = true;
      setButtonsDisabled(true);
      dom.analyzingOverlay.classList.remove("hidden");

      try {
        let predictions = [];

        if (appState.mockParams) {
          predictions = buildSyntheticPredictions(appState.mockParams.className, appState.mockParams.confidence);
        } else if (appState.isModelLoaded && appState.model) {
          const raw = await appState.model.predict(dom.previewImage);
          predictions = raw
            .map((r) => ({ className: r.className, probability: r.probability }))
            .sort((a, b) => b.probability - a.probability);
        } else {
          // 모델 파일이 없는 상태에서 사용자가 직접 사진을 올린 경우 안내 후 기본 체험 결과 표시
          showAlert("model 폴더에 AI 모델 파일이 없어 체험 결과(깨끗한 플라스틱 용기)로 표시합니다.", true);
          predictions = buildSyntheticPredictions(CLS_CLEAN_PLASTIC, 0.85);
        }

        appState.currentPredictions = predictions;
        renderResult(predictions);
      } catch (error) {
        console.error(error);
        showAlert("사진 분석 중 오류가 발생했어요. 다시 시도해 주세요.");
      } finally {
        appState.isAnalyzing = false;
        setButtonsDisabled(false);
        dom.analyzingOverlay.classList.add("hidden");
      }
    }

    function buildSyntheticPredictions(className, confidence) {
      const target = appState.isRetakeFlow && className === CLS_DIRTY_PLASTIC ? CLS_CLEAN_PLASTIC : className;
      const matched = APP_CONFIG.CLASSES.includes(target) ? target : CLS_CLEAN_PLASTIC;
      const others = APP_CONFIG.CLASSES.filter((c) => c !== matched);
      const rest = Math.max(0, 1 - confidence) / (others.length || 1);
      return [
        { className: matched, probability: confidence },
        ...others.map((c) => ({ className: c, probability: rest }))
      ].sort((a, b) => b.probability - a.probability);
    }

    function runDemoWithSampleImage(className, confidence, isRetake) {
      clearAlert();
      appState.isRetakeFlow = isRetake;
      appState.unwashableSelected = false;
      appState.mockParams = { className, confidence };

      // 캔버스로 간단한 샘플 카드 이미지 생성
      const canvas = document.createElement("canvas");
      canvas.width = 400;
      canvas.height = 240;
      const ctx = canvas.getContext("2d");
      ctx.fillStyle = "#e6fffa";
      ctx.fillRect(0, 0, 400, 240);
      ctx.fillStyle = "#0f766e";
      ctx.font = "bold 22px sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("🧪 체험용 샘플 이미지", 200, 105);
      ctx.font = "16px sans-serif";
      ctx.fillText(`(${className})`, 200, 140);

      dom.previewImage.onload = () => {
        dom.homeScreen.classList.add("hidden");
        dom.resultScreen.classList.remove("hidden");
        classifyCurrentImage();
      };
      dom.previewImage.src = canvas.toDataURL("image/png");
    }

    /**
     * 8. 결과 및 기능 A / B / C 렌더링
     */
    function renderResult(predictions) {
      const top1 = predictions[0];
      const top3 = predictions.slice(0, 3);
      const pct = Math.round(top1.probability * 100);
      const isConfident = top1.probability >= APP_CONFIG.CONFIDENCE_THRESHOLD;

      if (!isConfident) {
        dom.resultLabelCaption.textContent = "판정 보류";
        dom.resultClassName.textContent = `가능성이 있는 후보: ${top1.className}`;
        dom.resultClassName.classList.add("low-confidence");
        dom.resultConfidence.textContent = `신뢰도 ${pct}% (기준 ${Math.round(APP_CONFIG.CONFIDENCE_THRESHOLD * 100)}% 미만)`;
      } else {
        dom.resultLabelCaption.textContent = "가장 높은 예측 결과";
        dom.resultClassName.textContent = top1.className;
        dom.resultClassName.classList.remove("low-confidence");
        dom.resultConfidence.textContent = `신뢰도 ${pct}%`;
      }

      dom.top3Bars.innerHTML = top3.map((item) => {
        const p = Math.round(item.probability * 100);
        return `
          <div>
            <div class="bar-item-header"><span>${item.className}</span><span>${p}%</span></div>
            <div class="bar-track"><div class="bar-fill" style="width:${p}%"></div></div>
          </div>`;
      }).join("");

      dom.contextGuideSection.classList.add("hidden");
      dom.contextGuideSection.classList.remove("warn-state");
      dom.contextGuideActions.innerHTML = "";

      if (!isConfident) {
        dom.contextGuideSection.classList.remove("hidden");
        dom.contextGuideSection.classList.add("warn-state");
        dom.contextGuideMessage.textContent = "확실하지 않아요. 다시 찍거나 거주지 지자체의 분리배출 안내를 확인해 주세요.";
        addGuideButton("📷 다시 찍기", "btn btn-primary", () => startCamera(false));
      } else if (top1.className === CLS_DIRTY_PLASTIC) {
        dom.contextGuideSection.classList.remove("hidden");
        dom.contextGuideSection.classList.add("warn-state");
        dom.contextGuideMessage.textContent = "음식물이 남아 있어요. 비우고 헹군 뒤 다시 찍어 주세요.";
        addGuideButton("📷 다시 찍기", "btn btn-primary", () => {
          // 체험 모드일 때는 버튼 클릭 즉시 깨끗해진 상태 시연 가능하도록 지원
          if (!appState.isModelLoaded && appState.mockParams) {
            runDemoWithSampleImage(CLS_DIRTY_PLASTIC, 0.92, true);
          } else {
            startCamera(true);
          }
        });
        addGuideButton("그래도 지워지지 않아요", "btn btn-sub-action", () => {
          appState.unwashableSelected = true;
          dom.contextGuideMessage.textContent = "세척해도 지워지지 않는 오염 용기는 재활용이 어려우므로 일반 종량제봉투로 배출해 주세요.";
          renderChecklist(WASTE_CONTENT[CLS_DIRTY_PLASTIC].unwashableSteps);
        });
      } else if (appState.isRetakeFlow && top1.className === CLS_CLEAN_PLASTIC) {
        dom.contextGuideSection.classList.remove("hidden");
        dom.contextGuideMessage.textContent = "✨ 깨끗해졌어요! 아래 체크리스트에 따라 플라스틱류로 재활용 배출해 주세요.";
      }

      const steps = (top1.className === CLS_DIRTY_PLASTIC && appState.unwashableSelected)
        ? WASTE_CONTENT[CLS_DIRTY_PLASTIC].unwashableSteps
        : (WASTE_CONTENT[top1.className]?.steps || []);
      renderChecklist(steps);
    }

    function addGuideButton(label, cls, onClick) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = cls;
      btn.textContent = label;
      btn.addEventListener("click", onClick);
      dom.contextGuideActions.appendChild(btn);
    }

    /**
     * 9. 체크리스트 렌더링
     */
    function renderChecklist(steps) {
      appState.checkedSteps = new Array(steps.length).fill(false);
      dom.checklistItems.innerHTML = "";
      dom.checklistCompleteBanner.classList.add("hidden");

      steps.forEach((text, idx) => {
        const li = document.createElement("li");
        li.className = "checklist-item";
        const label = document.createElement("label");
        const cb = document.createElement("input");
        cb.type = "checkbox";
        cb.addEventListener("change", () => {
          appState.checkedSteps[idx] = cb.checked;
          li.classList.toggle("checked", cb.checked);
          updateChecklistProgress();
        });
        const span = document.createElement("span");
        span.textContent = text;
        label.append(cb, span);
        li.appendChild(label);
        dom.checklistItems.appendChild(li);
      });
      updateChecklistProgress();
    }

    function updateChecklistProgress() {
      const total = appState.checkedSteps.length;
      const done = appState.checkedSteps.filter(Boolean).length;
      dom.checklistProgress.textContent = `${done} / ${total} 완료`;
      dom.checklistCompleteBanner.classList.toggle("hidden", !(total > 0 && done === total));
    }
  </script>
</body>
</html>
